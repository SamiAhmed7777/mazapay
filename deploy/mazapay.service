# MazaPay bridge systemd unit.
# Installed by deploy/service/install-bridge.sh (staged release dirs:
# /opt/mazapay/releases/<epoch>, symlink /opt/mazapay/current).
# Secrets (token, wallet RPC credentials) live in /etc/mazapay.env (0600),
# assembled in-process by the installer from /var/lib/mazad/maza.conf —
# they are never written into this repo or printed to a transcript.

[Unit]
Description=MazaPay bridge — MazaCoin payments into MIP Fund Accounting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mazapay
Group=mazapay
WorkingDirectory=/opt/mazapay/current
EnvironmentFile=-/etc/mazapay.env
# Explicit bind, loopback-only behind the Caddy TLS proxy (audit 4.3):
# the per-IP order cap trusts X-Forwarded-For only because the listener
# is loopback-bound. PORT NOTE: keep in sync with LISTEN_PORT in
# deploy/service/install-bridge.sh — 8443 collides with SamiPanel (*:8443).
Environment=MAZAPAY_HOST=127.0.0.1
Environment=MAZAPAY_PORT=18500
# Production data paths (override dev defaults from config.py);
# StateDirectory provisions /var/lib/mazapay with correct ownership.
Environment=MAZAPAY_DB=/var/lib/mazapay/mazapay.sqlite3
Environment=MAZAPAY_MIP_EXPORT_DIR=/var/lib/mazapay/mip
StateDirectory=mazapay
ExecStartPre=/usr/bin/mkdir -p /var/lib/mazapay/mip
ExecStart=/usr/bin/python3 -m mazapay.api
Restart=always
RestartSec=3
# POST /payments spends from the wallet — run as its own user, no shell,
# no capabilities, no kernel/control-group surface, and (post-first-boot
# tightening) a syscall allowlist: @system-service covers CPython + sqlite3
# + urllib (epoll/futex/file I/O, AF_INET/AF_UNIX sockets, clone for
# threads); blocked syscalls return EPERM (SystemCallErrorNumber) so an
# unforeseen python need surfaces as a clean OSError, not an opaque SIGSYS
# kill. MemoryDenyWriteExecute is safe here: pure CPython, no JIT.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/mazapay
UMask=0077
ProtectClock=true
RestrictNamespaces=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Seccomp tier (declared residual of the 132870e deploy, tightened after
# first live boot verified 2026-11-15; live-proven via a throwaway
# mazapay-seccomp-test.service before rollout):
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectHostname=true
RemoveIPC=true
KeyringMode=private

[Install]
WantedBy=multi-user.target
