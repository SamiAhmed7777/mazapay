# MazaPay bridge systemd unit.
# Install:  sudo cp deploy/mazapay.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now mazapay
# Secrets (token, wallet RPC credentials) belong in /etc/mazapay.env (0600):
#   MAZAPAY_API_TOKEN=...
#   MAZAPAY_MAZAD_RPC=http://127.0.0.1:<rpcport>
#   MAZAPAY_MAZAD_RPC_USER=...
#   MAZAPAY_MAZAD_RPC_PASSWORD=...

[Unit]
Description=MazaPay bridge — MazaCoin payments into MIP Fund Accounting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mazapay
Group=mazapay
WorkingDirectory=/opt/mazapay
EnvironmentFile=-/etc/mazapay.env
# Production data paths (override dev defaults from config.py);
# StateDirectory provisions /var/lib/mazapay with correct ownership.
Environment=MAZAPAY_DB=/var/lib/mazapay/mazapay.sqlite3
Environment=MAZAPAY_MIP_EXPORT_DIR=/var/lib/mazapay/mip
StateDirectory=mazapay
ExecStartPre=/usr/bin/mkdir -p /var/lib/mazapay/mip
ExecStart=/usr/bin/python3 -m mazapay.api
Restart=always
RestartSec=3
# POST /payments spends from the wallet — run it as its own user, no shell
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/mazapay

[Install]
WantedBy=multi-user.target
